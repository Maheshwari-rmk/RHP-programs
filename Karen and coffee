import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        int a = in.nextInt();
        int b = in.nextInt();
        int c = in.nextInt();

        int size = 200002;

        int[] x = new int[size];

        for (int i = 0; i < a; i++) {
            int p = in.nextInt();
            int q = in.nextInt();
            x[p]++;
            x[q + 1]--;
        }

        int[] y = new int[size];
        for (int i = 1; i < size; i++) {
            y[i] = y[i - 1] + x[i];
        }

        int[] z = new int[size];
        for (int i = 1; i < size; i++) {
            z[i] = z[i - 1] + (y[i] >= b ? 1 : 0);
        }

        StringBuilder ans = new StringBuilder();

        for (int i = 0; i < c; i++) {
            int l = in.nextInt();
            int r = in.nextInt();
            ans.append(z[r] - z[l - 1]).append("\n");
        }

        System.out.print(ans);
    }
}
