#include<iostream>
#include<vector>
using namespace std;
int main(){
	int N;
	cin>>N;
	vector<int> arr(N+1);
	vector<int> psum(N+2,0);
	string ans;
	
	for(int i=1;i<=N;i++){
		cin>>arr[i];
		if(arr[i]>0){
			psum[max(1,i-arr[i]+1)]++;
			if(i+arr[i] <= N){
				psum[i+arr[i]]--;
			}
		}
	}
	for(int i=1;i<=N;i++){
		if(arr[i]!=-1){
			bool valid=false;
			if(i-arr[i]>=1 && psum[i-arr[i]]==0){
				valid=true;
			}
			if(i+arr[i] <=N && psum[i+arr[i]]==0){
				valid=true;
			}
			if(!valid){
				cout<<"-1"<<endl;
				return 0;
			}
		}
		ans.push_back(psum[i]==0?'1':'0');
	}
	cout<<ans<<endl;
}
