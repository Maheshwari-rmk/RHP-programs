import java.util.*;
import java.util.Arrays;
import java.util.Collections;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
		int S=sc.nextInt();
		int N=sc.nextInt();
		int[] s=new int[S];
		int[] n=new int[N];
		for(int i=0;i<S;i++){
		    s[i]=sc.nextInt();
		}
		for(int i=0;i<N;i++){
		    n[i]=sc.nextInt();
		}
		Arrays.sort(s);
		Arrays.sort(n);
		int i=S-1,j=N-1;
		int count=0;
	  while(i>=0 && j>=0 ){
		        if(n[j]<=2*s[i]){
		            i--;
		            j--;
		            count++;
		        }else{
		            j--;
		        }
		    }
		    System.out.println(count);
		}
	}
