#include<iostream>
#include<algorithm>
#include<queue>
using namespace std;

void solve(){
	int R,C,K;
	cin>>R>>C>>K;
	vector<string> g(R);
	for(int row=0;row<R;row++){
		cin>>g[row];
	}
	vector<bool>br(R,false),bc(C,false);
	queue<pair<int,int>> q;
	for(int row=0;row<R;row++){
		for(int col=0;col<C;col++){
			if(g[row][col]=='#'){
				br[row]=bc[col]=true;
			}
		}
	}
	
	vector<vector<bool>> vis(R,vector<bool>(C,false));
	for(int row=0;row<R;row++){
		for(int col=0;col<C;col++){
			if(!br[row] && !bc[col]){
				q.push(make_pair(row,col));
				vis[row][col]=true;
			}
		}
	}
	int hops=0;
	int cellcnt=0;
	while(!q.empty() && hops<=K){
		hops++;
		int qsize=q.size();
		cellcnt+=qsize;
		while(qsize--){
			auto[row,col]=q.front();
			q.pop();
			for(int i=0;i<4;i++){
				int ar=row+diff[i],ac=col+diff[i+1];
				if(ar>=0 && ar<R && ac>=0 && ac<C && !vis[ar][ac] && g[ar][ac]=='.'){
					vis[ar][ac]=true;
				}
			}
			
		}
		
	}
	cout<<cellcnt<<endl;
}
int main(){
	ios::syn_with_stdio(false);
	cin.tie(nullptr);
	int T=1;
	while(T--)solve();
}
