#include <iostream>
using namespace std;
int main() {
    string str;
    cin>>str;
    int flag1=0;
    int flag2=0;
    for(char ch:str){
        if(ch>='a'&& ch<='z'){
        flag1=flag1|(1<<(ch-'a'));
    }
        if(ch>='A' && ch<='Z'){
            flag2=flag2|(1<<(ch-'A'));
        }
    }
    if(flag1==(1<<26)-1 && flag2==(1<<26)-1){
        cout<<"YES"<<endl;
    }else{
        cout<<"No"<<endl;
    }
   

}
