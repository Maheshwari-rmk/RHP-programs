//carrot easy
#include<iostream>
#include<vector>
using namespace std;
int main(){
	int N,M;
	cin>>N>>M;
	vector<int> curr(N);
	vector<int> cnt(M+1,0);
	for(int ctr=1;ctr<=N;ctr++){
		cin>>curr[ctr];
		cnt[curr[ctr]]++;
	}
	vector<int>psum(M+1,0);
	for(int i=1;i<=M;i++){
		psum[i]=psum[i-1]+cnt[i];
	}
	
	int ans=0;
	for(int x=1;x<=M;x++){
		int carrotcnt=psum[M]-psum[x-1];
		if(2*x<=M){
			carrotcnt+=cnt[2*x];
		}
		ans=max(carrotcnt,ans);
	}
	cout<<ans<<endl;
}
